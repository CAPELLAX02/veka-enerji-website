  "bugs": {
    "url": "https://github.com/CAPELLAX02/veka-enerji-website/issues"
  },
  "homepage": "https://github.com/CAPELLAX02/veka-enerji-website#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "d3-geo": "^3.1.1",
    "lucide-static": "^1.48.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "private": true,
